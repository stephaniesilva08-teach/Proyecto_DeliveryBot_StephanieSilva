    {
      "parameters": {
        "jsCode": "const input = $items(\"Telegram Trigger\")[0].json;\nconst text = (input.message?.text || \"\").toLowerCase().trim();\n\n// 1. Leemos el estado actual del usuario desde el nodo anterior (Google Sheets / Sesión)\nconst estadoConversacion = $json.datos_entrega || \"\";\n\nlet intencion = \"DESCONOCIDO\";\n\n// 2. Si el usuario está esperando enviar su dirección, priorizamos esa intención\nif (estadoConversacion === \"DATOS_ENTREGA\") {\n  intencion = \"DATOS_ENTREGA\";\n} else if (text.includes(\"hola\") || text.includes(\"menu\") || text.includes(\"menú\") || text === \"/start\") {\n  intencion = \"SALUDAR_Y_MENU\";\n} else if (text.includes(\"carrito\") || text.includes(\"pagar\")) {\n  intencion = \"VER_CARRITO\";\n} else if (text.includes(\"estado\") || text.includes(\"historial\") || text.includes(\"pedido\")) {\n  intencion = \"VER_ESTADO\";\n}\n\nreturn [{ json: { intencion, text } }];"
      },
