    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst chatId = $('Telegram Trigger (Consulta Historial)').first().json.callback_query.message.chat.id;\n\nif (!items || items.length === 0 || !items[0].json.id_pedido) {\n  return [{\n    json: {\n      chat_id: chatId,\n      mensaje: '📜 *Historial de Pedidos*\\n\\nActualmente no tienes pedidos registrados en tu historial.'\n    }\n  }];\n}\n\nlet texto = '📜 *Tus Últimos Pedidos Realizados:*\\n\\n';\n\n// Mostrar los últimos 5 pedidos ordenados\nconst ultimos = items.slice(-5).reverse();\n\nultimos.forEach(item => {\n  const row = item.json;\n  texto += '🔹 *Pedido #' + row.id_pedido + '* - _' + row.fecha_entrega + '_\\n';\n  texto += '🛒 *Detalle:* ' + row.detalle + '\\n';\n  texto += '📍 *Dirección:* ' + row.datos_entrega + '\\n';\n  texto += '💵 *Total:* $' + row.total + '\\n';\n  texto += '----------------------------------\\n';\n});\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    mensaje: texto\n  }\n}];"
      },
