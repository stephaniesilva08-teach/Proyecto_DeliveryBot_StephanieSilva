    {
      "parameters": {
        "jsCode": "const u = $json;\nconst cb = u.callback_query;\nconst msg = u.message;\nconst text = (msg && msg.text ? String(msg.text) : '').trim();\nconst chatId = msg ? msg.chat.id : (cb && cb.message ? cb.message.chat.id : null);\nconst ADMIN = '8438660376';\n\nlet ruta = 'DIRECCIONES';\n\nif (cb && cb.data) {\n  const d = String(cb.data);\n  // Botones de estado del admin (estado_preparacion / estado_encamino / estado_entregado)\n  if (d.startsWith('estado_')) {\n    ruta = 'COCINA';\n  } else if (d.startsWith('ver_historial')) {\n    // Historial ahora se dispara con el BOTÓN (solo admin)\n    ruta = (String(chatId) === ADMIN) ? 'HISTORIAL' : 'PEDIDOS';\n  } else {\n    ruta = 'PEDIDOS';\n  }\n} else if (text) {\n  const t = text.toLowerCase();\n  if (t === '/start' || t.includes('hola') || t.includes('menu') || t.includes('menú') || t.includes('buenas')) {\n    ruta = 'MENU';\n  } else {\n    ruta = 'DIRECCIONES';\n  }\n}\n\nreturn [{ json: Object.assign({}, u, { ruta: ruta }) }];"
      },
