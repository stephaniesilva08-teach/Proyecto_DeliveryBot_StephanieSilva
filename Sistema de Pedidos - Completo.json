    {
      "parameters": {
        "jsCode": "// 1. Datos recibidos de Procesar Pedido e ID\nconst pedido = $('Procesar Pedido e ID').item.json;\n\n// 2. Buscamos el producto coincidente en Leer Stock Actual\nconst productos = $('Leer Stock Actual').all().map(item => item.json);\nconst productoEncontrado = productos.find(p => String(p.id_producto) === String(pedido.prod_id)) || {};\n\n// 3. Obtenemos datos del producto\nconst nombreProducto = productoEncontrado.nombre || 'Producto Desconocido';\nconst precioUnitario = Number(productoEncontrado.precio || 0);\nconst stockActual = Number(productoEncontrado.stock || 0);\n\n// 4. Cálculos\nconst cantidad = Number(pedido.cantidad || 1);\nconst stockNuevo = stockActual - cantidad;\nconst total = cantidad * precioUnitario;\n\nreturn {\n  json: {\n    chat_id: pedido.chat_id,\n    id_pedido: pedido.id_pedido,\n    prod_id: pedido.prod_id,\n    nombre: nombreProducto,\n    precio: precioUnitario,\n    cantidad: cantidad,\n    total: total,\n    fecha: pedido.fecha,\n    stock_anterior: stockActual,\n    stock_nuevo: stockNuevo\n  }\n};"
      },
