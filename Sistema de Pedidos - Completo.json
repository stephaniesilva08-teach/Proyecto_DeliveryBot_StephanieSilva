    {
      "parameters": {
        "jsCode": "const originalData = String($('When Executed by Another Workflow').item.json.data || '').trim();\nconst chatId = $('When Executed by Another Workflow').item.json.chatId;\n\n// Si por error entra un comando en lugar de una categoría real, no buscamos nada\nif (originalData.startsWith('action=') || originalData.startsWith('p_id=')) {\n  return { json: { chat_id: chatId, texto: \"Por favor selecciona una opción válida del menú.\", reply_markup: JSON.stringify({ inline_keyboard: [] }) } };\n}\n\nconst cat = originalData;\nconst todosLosProductos = $input.all().map(item => item.json);\n\nconst productosFiltrados = todosLosProductos.filter(p => \n  p.categoria && String(p.categoria).trim().toLowerCase() === cat.toLowerCase()\n);\n\nconst botones = productosFiltrados.map(p => ([{\n  text: `${p.nombre} - $${p.precio}`,\n  callback_data: `p_id=${p.id_producto}`\n}]));\n\n// Botón para regresar al menú principal\nbotones.push([{ text: '⬅️ Volver al Menú', callback_data: 'action=menu' }]);\n\nreturn {\n  json: {\n    chat_id: chatId,\n    texto: productosFiltrados.length\n      ? `📋 *Productos en ${cat.toUpperCase()}:*\\nElige uno para continuar 👇`\n      : `😕 No hay productos disponibles en *${cat}* por ahora.`,\n    reply_markup: JSON.stringify({ inline_keyboard: botones })\n  }\n};"
      },
      "id": "f8782469-a1e1-4459-a5dc-1a2f1875eff8",
      "name": "Filtrar y Armar Botones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        272
      ]
