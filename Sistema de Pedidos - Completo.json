        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.texto, parse_mode: 'Markdown', reply_markup: JSON.parse($json.reply_markup) }) }}",
        "options": {}
      },
      "id": "1e982e21-832a-423c-890b-45842515b719",
      "name": "Mostrar Productos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        944,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Obtenemos lo que devolvió la búsqueda en Google Sheets\nconst filasSheets = $input.all();\nconst primerRegistro = filasSheets[0]?.json || {};\n\n// 2. Obtenemos la información del nuevo producto recién seleccionado\nconst itemNuevo = $('Calcular Nuevo Stock').first().json;\n\nconst chatId = itemNuevo.chat_id || itemNuevo.chatId || primerRegistro.chat_id;\nconst nomNuevo = itemNuevo.nombre || 'Producto';\nconst cantNueva = Number(itemNuevo.cantidad || 1);\nconst subNuevo = Number(itemNuevo.total || (cantNueva * Number(itemNuevo.precio || 0)));\n\n// 3. Leemos lo que ya tenía guardado en la columna \"detalle\" y \"total\"\nlet detalleExistente = primerRegistro.detalle || '';\nlet totalExistente = Number(primerRegistro.total || 0);\n\nlet detalleFinal = '';\nlet totalFinal = 0;\n\nif (detalleExistente && String(detalleExistente).trim() !== '') {\n  // Si ya existía un pedido, concatenamos en una línea nueva\n  detalleFinal = `${detalleExistente}\\n• ${cantNueva}x ${nomNuevo} ($${subNuevo})`;\n  totalFinal = totalExistente + subNuevo;\n} else {\n  // Si es el primer producto del carrito\n  detalleFinal = `• ${cantNueva}x ${nomNuevo} ($${subNuevo})`;\n  totalFinal = subNuevo;\n}\n\nreturn {\n  json: {\n    chat_id: chatId,\n    detalle: detalleFinal,\n    total: totalFinal,\n    estado: 'borrador'\n  }\n};"
      },
