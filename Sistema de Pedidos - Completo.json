    {
      "parameters": {
        "jsCode": "// Leemos la fila recuperada de Google Sheets\nconst filaCarrito = $input.first()?.json || {};\n\nconst chatId = filaCarrito.chat_id || $json.chatId || $json.chat_id;\nconst detalleTexto = filaCarrito.detalle || 'Sin detalle de productos';\nconst totalPagar = Number(filaCarrito.total || 0);\n\n// Generamos un ID de pedido único\nconst idPedido = \"PED-\" + Math.floor(100000 + Math.random() * 900000);\n\n// Convertimos el texto de la columna 'detalle' a formato HTML (cambiando saltos de línea por <br>)\nconst detalleHTML = String(detalleTexto).replace(/\\n/g, '<br>');\n\nreturn {\n  json: {\n    chat_id: chatId,\n    id_pedido: idPedido,\n    detalle_html: detalleHTML,\n    detalle_texto: detalleTexto,\n    total: totalPagar,\n    fecha: new Date().toISOString()\n  }\n};"
      },
