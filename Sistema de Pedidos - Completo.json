      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot8487284251:AAFf534XZGimwVNPY13H-3ONP9l-vOTeqkY/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": {{ $json.chat_id }},\n  \"text\": {{ JSON.stringify(\"🛒 *Resumen de tu pedido:*\\n\" + $json.detalle + \"\\n\\n*Total:* $\" + $json.total + \"\\n\\n¿Qué deseas hacer?\") }},\n  \"parse_mode\": \"Markdown\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [\n        { \"text\": \"➕ Agregar otro\", \"callback_data\": \"action=menu\" }\n      ],\n      [\n        { \"text\": \"✅ Confirmar Pedido\", \"callback_data\": \"action=confirmar_final\" }\n      ],\n      [\n        { \"text\": \"⬅️ Volver al Menú\", \"callback_data\": \"action=menu\" }\n      ]\n    ]\n  }\n}",
        "options": {}
      },
