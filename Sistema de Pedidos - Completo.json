    {
      "parameters": {
        "jsCode": "// 1. Capturar variables del nodo trigger de forma segura\nconst inputData = $('When Executed by Another Workflow').item.json;\nconst callbackData = String(inputData.data || inputData.callback_query?.data || '');\nconst chatId = inputData.chatId || inputData.chat_id || inputData.callback_query?.message?.chat?.id || '000000';\n\n// 2. Extraer el ID del producto (soporta formatos: \"p_id=P001\" o \"confirmar_P001\")\nlet prodId = 'P001';\nif (callbackData.includes('=')) {\n  prodId = callbackData.split('=')[1] || 'P001';\n} else if (callbackData.includes('_')) {\n  prodId = callbackData.split('_')[1] || 'P001';\n} else {\n  prodId = callbackData;\n}\n\n// 3. Cantidad por defecto para el primer clic\nconst qty = 1;\n\n// 4. Generar ID único de pedido (PED-XXXXXX)\nconst timestamp = Date.now().toString().slice(-5);\nconst random = Math.floor(Math.random() * 90 + 10);\nconst idPedido = `PED-${timestamp}${random}`;\n\nreturn {\n  json: {\n    chat_id: chatId,\n    id_pedido: idPedido,\n    prod_id: prodId,\n    cantidad: qty,\n    fecha: new Date().toISOString()\n  }\n};"
      },
