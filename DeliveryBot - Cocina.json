      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst callbackQuery = body.callback_query;\nconst data = callbackQuery.data;\nconst [accionRaw, idPedido] = data.split(':');\n\nconst mapaEstados = {\n  estado_preparacion: { tipo: 'preparacion', texto: 'En Preparación', emoji: '👨‍🍳' },\n  estado_encamino:    { tipo: 'encamino',    texto: 'En Camino',       emoji: '🛵' },\n  estado_entregado:   { tipo: 'entregado',   texto: 'Entregado',       emoji: '✅' }\n};\n\nconst estado = mapaEstados[accionRaw] || { tipo: 'desconocido', texto: 'Actualizado', emoji: '🔄' };\n\nreturn [{\n  json: {\n    id_pedido: idPedido,\n    accion: accionRaw,\n    tipo_estado: estado.tipo,\n    estado_texto: estado.texto,\n    estado_emoji: estado.emoji,\n    callback_query_id: callbackQuery.id,\n    chat_id_cocina: callbackQuery.message.chat.id,\n    message_id_cocina: callbackQuery.message.message_id\n  }\n}];"
      },
